POSTGRES_DB=formulario_dinamico
POSTGRES_USER=formulario
POSTGRES_PASSWORD=

ASPNETCORE_ENVIRONMENT=Production

# Obrigatório: chave JWT com mínimo 32 caracteres — TROQUE ANTES DE SUBIR EM PRODUÇÃO
JWT_SECRET=
JWT_EMISSOR=FormularioDinamico
JWT_AUDIENCIA=FormularioDinamico
JWT_EXPIRACAO_HORAS=8

VITE_API_URL=/api

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=https://formulario.cloudlane.com.br
